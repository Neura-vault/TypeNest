# ============================================
# TypeNest — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already in .gitignore.
# ============================================

# --- Supabase (required) ---
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER-SIDE ONLY, never expose to the browser.
# Found in the same Settings -> API page ("service_role" secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site URL (used for auth redirects, OG tags, sitemap) ---
# Leave as localhost for development. Set to your real domain after deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
